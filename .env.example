# Only these values are required for the Docker stack.
# Run `python scripts/init_env.py` to generate the local secrets.
# Never commit `.env` or the GitHub private key.
POSTGRES_PASSWORD=replace-with-a-long-random-value

GITHUB_APP_ID=replace-with-app-id
GITHUB_INSTALLATION_ID=replace-with-installation-id
GITHUB_PRIVATE_KEY_FILE=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=replace-with-the-value-configured-on-the-github-app

# Local recovery note only; Compose does not pass this plaintext to the app.
ADMIN_PASSWORD=local-login-password
ADMIN_PASSWORD_HASH=replace-with-scrypt-hash
SESSION_SECRET=replace-with-a-long-random-value
