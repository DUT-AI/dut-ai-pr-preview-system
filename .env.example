# Copy to `.env` or run `python scripts/init_env.py` to generate secrets.
# Never commit `.env` or any file under `secrets/`.

# -----------------------------------------------------------------------------
# DOCKER COMPOSE
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=dut-ai-pr-preview
# Set to `.env.local` when running the development compose override.
APP_ENV_FILE=.env

# -----------------------------------------------------------------------------
# POSTGRESQL DATABASE
# POSTGRES_EXTERNAL_PORT is published on the Docker host.
# POSTGRES_INTERNAL_PORT is the port used inside the Compose network.
# Docker requires a numeric bind IP. 127.0.0.1 is accessed as localhost.
# Keep this loopback value unless remote DB access is deliberately secured.
# Use a URL-safe password and keep DATABASE_URL in sync with these values.
# -----------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=dut_ai_pr_preview
POSTGRES_USER=dut_ai
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-value
POSTGRES_HOST=postgres
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_EXTERNAL_PORT=3637
POSTGRES_INTERNAL_PORT=5432
DATABASE_URL=postgresql://dut_ai:replace-with-a-long-url-safe-random-value@postgres:5432/dut_ai_pr_preview

# -----------------------------------------------------------------------------
# WEB UI / API
# WEB_EXTERNAL_PORT is opened on the host; WEB_INTERNAL_PORT is inside Docker.
# Change the GitHub App webhook separately to https://<domain>/webhooks/github.
# -----------------------------------------------------------------------------
WEB_BIND_HOST=127.0.0.1
WEB_EXTERNAL_PORT=3636
WEB_INTERNAL_PORT=8000

# -----------------------------------------------------------------------------
# ADMIN AUTH / SESSION SIGNING
# There is no standalone JWT_SECRET. Admin login uses signed session/CSRF cookies.
# GitHub App JWTs are generated from GITHUB_APP_ID and the private-key PEM below.
# ADMIN_PASSWORD is a local recovery value and is not passed into the containers.
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-local-login-password
ADMIN_PASSWORD_HASH=replace-with-scrypt-hash
SESSION_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# GITHUB APP / JWT / WEBHOOK
# *_FILE is the path on the Docker host; *_PATH is the path inside containers.
# -----------------------------------------------------------------------------
GITHUB_APP_ID=replace-with-app-id
GITHUB_INSTALLATION_ID=replace-with-installation-id
# Comma-separated exact repositories, or a strict owner-wide scope such as DUT-AI/*.
GITHUB_ALLOWED_REPOSITORIES=DUT-AI/dut-ai-pr-preview-system
GITHUB_PRIVATE_KEY_FILE=./secrets/github-app.pem
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=replace-with-the-value-configured-on-the-github-app

# -----------------------------------------------------------------------------
# LLM PROVIDER
# Keep LLM_API_KEY empty for the current keyless internal endpoint. The Harness
# process intentionally refuses to receive an application/provider secret.
# -----------------------------------------------------------------------------
LLM_BASE_URL=https://llm2.dutai.site/v1
LLM_MODEL=ggml-org/gemma-4-e4b-it-GGUF:Q4_0
LLM_API_KEY=

# -----------------------------------------------------------------------------
# REVIEW POLICY / STORAGE
# Publication stays off until one stored preview is explicitly approved.
# -----------------------------------------------------------------------------
PUBLISH_ENABLED=false
DSH_SESSION_ROOT=/data/sessions
LOG_LEVEL=INFO
